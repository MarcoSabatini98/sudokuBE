PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_heidisql_username
DB_PASSWORD=your_password
DB_NAME=sudoku
DB_TIMEZONE=+02:00
DB_LOGGING=false
# Percorso CA per TLS (deploy su Aiven), es. aiven-ca.pem
DB_SSL_CA=

CORS_ORIGIN=http://localhost:4200
# Proxy davanti all'app: Render 1, Vercel + Render 2
TRUST_PROXY=1
