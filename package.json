{
  "name": "sudokube",
  "version": "1.0.0",
  "description": "Sudoku game backend",
  "main": "server.js",
  "scripts": {
    "lint": "eslint . && echo \"✓ Lint passed — no issues found\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "setup": "node scripts/setup.js",
    "migrate": "sequelize db:migrate",
    "migrate:undo": "sequelize db:migrate:undo",
    "migrate:undo:all": "sequelize db:migrate:undo:all",
    "migrate:status": "sequelize db:migrate:status"
  },
  "type": "commonjs",
  "author": "Marco",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.20.0",
    "sequelize": "^6.37.8",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}
